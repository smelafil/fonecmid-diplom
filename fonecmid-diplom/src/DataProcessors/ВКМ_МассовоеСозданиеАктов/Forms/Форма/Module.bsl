//Филиппова
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Объект.Период = НачалоМесяца(ТекущаяДатаСеанса());
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура ПериодПриИзменении(Элемент)
	Объект.Период = НачалоМесяца(Объект.Период);
	Объект.СписокДоговоров.Очистить();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ЗаполнитьСписокДоговоров(Команда)
	Если Не ЗначениеЗаполнено(Объект.Период) Тогда
		ПоказатьПредупреждение(, "Укажите период формирования актов.");
		Возврат;
	КонецЕсли;
	ЗаполнитьСписокНаСервере();
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСписокНаСервере()
	
	Объект.СписокДоговоров.Очистить();
	НачалоМесяца = НачалоМесяца(Объект.Период);
	КонецМесяца = КонецМесяца(Объект.Период);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Договоры.Ссылка КАК Договор,
	|	Договоры.Владелец КАК Контрагент,
	|	Реализации.Ссылка КАК Реализация
	|ИЗ
	|	Справочник.ДоговорыКонтрагентов КАК Договоры
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.РеализацияТоваровУслуг КАК Реализации
	|		ПО Договоры.Ссылка = Реализации.Договор
	|		И Реализации.Дата МЕЖДУ &НачалоМесяца И &КонецМесяца
	|		И НЕ Реализации.ПометкаУдаления
	|ГДЕ
	|	НЕ Договоры.ПометкаУдаления
	|	И Договоры.ВидДоговора = &ВидДоговора"; 
	
	Запрос.УстановитьПараметр("НачалоМесяца", НачалоМесяца);
	Запрос.УстановитьПараметр("КонецМесяца", КонецМесяца);
	Запрос.УстановитьПараметр("ВидДоговора", Перечисления.ВидыДоговоровКонтрагентов.ВКМ_АбоненскоеОбслуживание);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = Объект.СписокДоговоров.Добавить();
		НоваяСтрока.Договор = Выборка.Договор;
		НоваяСтрока.Контрагент = Выборка.Контрагент;
		НоваяСтрока.РеализацияТоваровУслуг = Выборка.Реализация;
		Если ЗначениеЗаполнено(Выборка.Реализация) Тогда
			НоваяСтрока.Комментарий = "Реализация уже сформирована";
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура Сформировать(Команда)
	
	Если Объект.СписокДоговоров.Количество() = 0 Тогда
		ПоказатьПредупреждение(, "Список договоров пуст. Сначала выполните заполнение.");
		Возврат;
	КонецЕсли;
	
	ДлительнаяОперация = ЗапуститьФормированиеВФоне();
	
	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ПараметрыОжидания.ВыводитьОкноОжидания = ИСТИНА;
	ПараметрыОжидания.ТекстСообщения = "Выполняется формирование документов реализации...";
	
	Оповещение = Новый ОписаниеОповещения("ПослеФормированияВФоне", ЭтотОбъект);
	ДлительныеОперацииКлиент.ОжидатьЗавершение(ДлительнаяОперация, Оповещение, ПараметрыОжидания);
	
КонецПроцедуры

&НаСервере
Функция ЗапуститьФормированиеВФоне()
	
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(УникальныйИдентификатор);
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = "Массовое создание актов реализации";
	
	ПараметрыЗадания = Новый Структура;
	ПараметрыЗадания.Вставить("Период", Объект.Период);
	ПараметрыЗадания.Вставить("ТаблицаДоговоров", Объект.СписокДоговоров.Выгрузить());   
	ПараметрыЗадания.Вставить("Организация", Объект.Организация);
	ПараметрыЗадания.Вставить("ТаблицаДоговоров", Объект.СписокДоговоров.Выгрузить());
	
	Возврат ДлительныеОперации.ВыполнитьВФоне(
		"Обработки.ВКМ_МассовоеСозданиеАктов.СформироватьРеализацииВФоне",
		ПараметрыЗадания,
		ПараметрыВыполнения);
		
КонецФункции

&НаКлиенте
Процедура ПослеФормированияВФоне(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Результат.Статус = "Выполнено" Тогда
		ЗагрузитьРезультатИзХранилища(Результат.АдресРезультата);
		ПоказатьОповещениеПользователя("Формирование актов завершено.");
	Иначе
		ПоказатьПредупреждение(, "Ошибка при выполнении операции: " + Результат.КраткоеПредставлениеОшибки);
	КонецЕсли;     
	
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьРезультатИзХранилища(АдресРезультата)
	ТаблицаДоговоров = ПолучитьИзВременногоХранилища(АдресРезультата);
	Объект.СписокДоговоров.Загрузить(ТаблицаДоговоров);
КонецПроцедуры


#КонецОбласти
