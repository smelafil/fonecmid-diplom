#Область ПрограммныйИнтерфейс

&НаСервере
// Формирует реализации по договорам.
// 
// Параметры
Процедура СформироватьРеализацииВФоне(Параметры, АдресРезультата) Экспорт
	
	НачалоМесяца = НачалоМесяца(Параметры.Период);
	КонецМесяца = КонецМесяца(Параметры.Период);
	
	ТаблицаДоговоров = Параметры.ТаблицаДоговоров;
	
	Для Каждого СтрокаТЧ Из ТаблицаДоговоров Цикл
		
		Если ЗначениеЗаполнено(СтрокаТЧ.Реализация) Тогда
			Продолжить;
		КонецЕсли;
		
		СуществующийДокумент = НайтиСуществующуюРеализацию(СтрокаТЧ.Договор, НачалоМесяца, КонецМесяца);
		Если ЗначениеЗаполнено(СуществующийДокумент) Тогда
			СтрокаТЧ.Реализация = СуществующийДокумент;
			СтрокаТЧ.Комментарий = "Документ уже существовал в базе";
			Продолжить;
		КонецЕсли;
		
		СоздатьИПровестиРеализацию(СтрокаТЧ, КонецМесяца);
		
	КонецЦикла;
	
	ПоместитьВоВременноеХранилище(ТаблицаДоговоров, АдресРезультата);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура СоздатьИПровестиРеализацию(СтрокаТЧ, ДатаДокумента)
	
	ДокументОбъект = Документы.РеализацияТоваровУслуг.СоздатьДокумент();
	ДокументОбъект.Дата = ДатаДокумента;
	ДокументОбъект.Договор = СтрокаТЧ.Договор;
	ДокументОбъект.Контрагент = СтрокаТЧ.Контрагент;
	
	ПараметрыЗаполнения = Новый Структура("Договор, Контрагент", СтрокаТЧ.Договор, СтрокаТЧ.Контрагент);
	ДокументОбъект.Заполнить(ПараметрыЗаполнения);
	
	ДокументОбъект.ВыполнитьАвтозаполнение();
	
	Если Не ДокументОбъект.ПроверитьЗаполнение() Тогда
		СтрокаТЧ.Комментарий = "Ошибка проверки заполнения. Документ не записан.";
		Возврат;
	КонецЕсли;
	
	Попытка
		ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);
		СтрокаТЧ.Реализация = ДокументОбъект.Ссылка;
		СтрокаТЧ.Комментарий = "Успешно создан и проведен";
	Исключение
		СтрокаТЧ.Комментарий = "Ошибка проведения: " + ОписаниеОшибки();
	КонецПопытки;
	
КонецПроцедуры

Функция НайтиСуществующуюРеализацию(Договор, НачалоМесяца, КонецМесяца)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	РеализацияТоваровУслуг.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.РеализацияТоваровУслуг КАК РеализацияТоваровУслуг
	|ГДЕ
	|	РеализацияТоваровУслуг.Договор = &Договор
	|	И РеализацияТоваровУслуг.Дата МЕЖДУ &НачалоМесяца И &КонецМесяца
	|	И НЕ РеализацияТоваровУслуг.ПометкаУдаления";
	
	Запрос.УстановитьПараметр("Договор", Договор);
	Запрос.УстановитьПараметр("НачалоМесяца", НачалоМесяца);
	Запрос.УстановитьПараметр("КонецМесяца", КонецМесяца);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
	Возврат Документы.РеализацияТоваровУслуг.ПустаяСсылка();
	
КонецФункции

#КонецОбласти