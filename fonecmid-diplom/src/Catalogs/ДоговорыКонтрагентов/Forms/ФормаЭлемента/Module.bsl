#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ВКМ_ДобавлениеЭлементов();
	
КонецПроцедуры  

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ВКМ_УстановитьВидимостьЭлементовФормы()
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ВидДоговораПриИзменении(Элемент)
	
	ВКМ_УстановитьВидимостьЭлементовФормы();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ВКМ_ДобавлениеЭлементов()
	
	//++ Филиппова
	
	//добавление элементов ВКМ_ГруппаДатыДоговора, ВКМ_ДатаНачала, ВКМ_ДатаОкончания,	ВКМ_суммаАбонентскойПлаты, ВКМ_СтоимостьАбонентскойПлаты
    ГруппаАбонентскоеОбслуживание = Элементы.Добавить("ВКМ_ГруппаАбонентскоеОбслуживание", Тип("ГруппаФормы")); 
	ГруппаАбонентскоеОбслуживание.Вид = ВидГруппыФормы.ОбычнаяГруппа;  
	ГруппаАбонентскоеОбслуживание.ОтображатьЗаголовок = Ложь;
	ГруппаАбонентскоеОбслуживание.СквозноеВыравнивание = СквозноеВыравнивание.Использовать;
	ГруппаАбонентскоеОбслуживание.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;

	НоваяГруппа = Элементы.Добавить("ВКМ_ГруппаДатыДоговора", Тип("ГруппаФормы"),ГруппаАбонентскоеОбслуживание); 
	НоваяГруппа.Вид = ВидГруппыФормы.ОбычнаяГруппа;  
	НоваяГруппа.ОтображатьЗаголовок = Ложь;
	НоваяГруппа.СквозноеВыравнивание = СквозноеВыравнивание.Использовать;
	НоваяГруппа.Группировка = ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяВсегда;
		
	НовыйЭлемент = Элементы.Добавить("ВКМ_ДатаНачала", Тип("ПолеФормы"), НоваяГруппа);
	НовыйЭлемент.Вид = ВидПоляФормы.ПолеВвода;
	НовыйЭлемент.ПутьКДанным = "Объект.ВКМ_ДатаНачала"; 
		
	НовыйЭлемент = Элементы.Добавить("ВКМ_ДатаОкончания", Тип("ПолеФормы"), НоваяГруппа);
	НовыйЭлемент.Вид = ВидПоляФормы.ПолеВвода;
	НовыйЭлемент.ПутьКДанным = "Объект.ВКМ_ДатаОкончания"; 
		
	НовыйЭлемент = Элементы.Добавить("ВКМ_СуммаАбонентскойПлаты", Тип("ПолеФормы"), ГруппаАбонентскоеОбслуживание);
	НовыйЭлемент.Вид = ВидПоляФормы.ПолеВвода;
	НовыйЭлемент.ПутьКДанным = "Объект.ВКМ_СуммаАбонентскойПлаты"; 
	
	НовыйЭлемент = Элементы.Добавить("ВКМ_СтоимостьЧасаРаботы", Тип("ПолеФормы"), ГруппаАбонентскоеОбслуживание);
	НовыйЭлемент.Вид = ВидПоляФормы.ПолеВвода;
	НовыйЭлемент.ПутьКДанным = "Объект.ВКМ_СтоимостьЧасаРаботы"; 
	
    //-- Филиппова
КонецПроцедуры

&НаКлиенте
//++ Филиппова
// Функция устанавливает видимость элементов формы для ВКМ
Процедура ВКМ_УстановитьВидимостьЭлементовФормы()
	
	Если Объект.ВидДоговора = ПредопределенноеЗначение("Перечисление.ВидыДоговоровКонтрагентов.ВКМ_АбоненскоеОбслуживание") Тогда
		Элементы.ВКМ_ГруппаАбонентскоеОбслуживание.Видимость = Истина;
	Иначе
		Элементы.ВКМ_ГруппаАбонентскоеОбслуживание.Видимость = Ложь;
	КонецЕсли;
	
КонецПроцедуры	

#КонецОбласти


