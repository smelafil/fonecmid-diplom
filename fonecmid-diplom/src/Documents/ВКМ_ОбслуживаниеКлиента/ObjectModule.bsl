
#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

Перем ЭтоНовыйДокумент;
Перем РеквизитыИзменились;

#Область ОбработчикиСобытий

Процедура ОбработкаПроведения(Отказ,Режим)
	
	Если Не ЗначениеЗаполнено(Договор) Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Не выбран договор!";
		Сообщение.Поле = "Договор";
		Сообщение.Сообщить();
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	СтруктураПараметров = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Договор, 
		"ВидДоговора, ВКМ_ДатаНачала, ВКМ_ДатаОкончания, ВКМ_СтоимостьЧасаРаботы");
	
	Если НЕ СтруктураПараметров.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.ВКМ_АбоненскоеОбслуживание Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "По выбранному договору не предусмотрена абонентская плата!";
		Сообщение.Поле = "Договор";
		Отказ = Истина;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СтруктураПараметров.ВКМ_ДатаНачала) И Дата < СтруктураПараметров.ВКМ_ДатаНачала Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Дата документа меньше даты начала действия договора!";
		Сообщение.Поле = "Дата";
		Сообщение.Сообщить();
		Отказ = Истина;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СтруктураПараметров.ВКМ_ДатаОкончания) И Дата > КонецДня(СтруктураПараметров.ВКМ_ДатаОкончания) Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Срок действия договора уже истек!";
		Сообщение.Поле = "Дата";
		Сообщение.Сообщить();
		Отказ = Истина;
	КонецЕсли;
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
		
	Движения.ВКМ_ВыполненныеКлиентуРаботы.Записывать = Истина;
	Движения.ВКМ_ВыполненныеКлиентуРаботы.Очистить();
	
	СтавкаЧаса = СтруктураПараметров.ВКМ_СтоимостьЧасаРаботы;

	Для Каждого СтрокаТЧ Из ВыполненныеРаботы Цикл
		Движение = Движения.ВКМ_ВыполненныеКлиентуРаботы.Добавить();
		Движение.ВидДвижения   = ВидДвиженияНакопления.Приход;
		Движение.Период        = Дата;
		Движение.Клиент        = Клиент; 
		Движение.Договор       = Договор;
		Движение.КоличествоЧасов = СтрокаТЧ.ФактическиПодраченоЧасов;
		Движение.СуммаКОплате  = Движение.КоличествоЧасов * СтавкаЧаса;
	КонецЦикла;

КонецПроцедуры   


Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ЭтоНовыйДокумент = ЭтоНовый();
	РеквизитыИзменились = Ложь;
	
	Если Не ЭтоНовыйДокумент Тогда
		
		СсылкаНаБазу = Ссылка.ПолучитьОбъект();
		
		Если СсылкаНаБазу.Дата <> Дата
			ИЛИ СсылкаНаБазу.ВремяНачалоРабот <> ВремяНачалоРабот
			ИЛИ СсылкаНаБазу.ВремяОкончанияРабот <> ВремяОкончанияРабот
			Или СсылкаНаБазу.Специалист <> Специалист Тогда			
			РеквизитыИзменились = Истина;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Процедура ПриЗаписи(Отказ)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Если ЭтоНовыйДокумент Или РеквизитыИзменились Тогда
		
		ШаблонТекста = ?(ЭтоНовыйДокумент, "Создан новый документ ""Обслуживание клиента""!", "Изменились параметры документа ""Обслуживание клиента""!");
		
		ТекстСообщения = СтрШаблон("%1%2Номер: %3%2Дата/Время: %4%2Специалист: %5", 
			ШаблонТекста, 
			Символы.ПС, 
			Номер, 
			Формат(Дата, "ДФ='dd.MM.yyyy HH:mm'"), 
			Строка(Специалист));
		
		НовоеУведомление = Справочники.ВКМ_УведомленияТелеграмБоту.СоздатьЭлемент();
		НовоеУведомление.ТекстСообщения = ТекстСообщения;
		НовоеУведомление.Записать();
		
	КонецЕсли;
	
КонецПроцедуры
	
#КонецОбласти

#КонецЕсли	
