Процедура ОтправитьОчередьСообщенийТелеграм() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Уведомления.Ссылка КАК Ссылка,
		|	Уведомления.ТекстСообщения КАК ТекстСообщения
		|ИЗ
		|	Справочник.ВКМ_УведомленияТелеграмБоту КАК Уведомления";
		
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Успешно = ВКМ_ИнтеграцияСТелеграмСервер.ОтправитьСообщениеВТелеграм(Выборка.ТекстСообщения);
		
		Если Успешно Тогда
			
			ОбъектСообщения = Выборка.Ссылка.ПолучитьОбъект();
			Попытка
				ОбъектСообщения.Удалить();
			Исключение
				ЗаписьЖурналаРегистрации("Telegram.Очередь", УровеньЖурналаРегистрации.Ошибка, , , 
					"Не удалось удалить отправленное уведомление: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			КонецПопытки;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры