
#Область СлужебныеПроцедурыИФункции

Функция ОтправитьСообщениеВТелеграм(Знач ТекстСообщения) Экспорт
	
	Токен = Константы.ВКМ_ТокенУправленияТелеграмБотом.Получить();
	ЧатID = Константы.ВКМ_ИдентификаторГруппыДляОповещения.Получить();
	
	Если Не ЗначениеЗаполнено(Токен) Или Не ЗначениеЗаполнено(ЧатID) Тогда
		ЗаписьЖурналаРегистрации("Telegram.Интеграция", УровеньЖурналаРегистрации.Предупреждение, , , 
			"Не заполнены настройки подключения (Токен или Chat ID).");
		Возврат Ложь;
	КонецЕсли;
	
	// Формируем параметры запроса
	ПараметрыЗапроса = Новый Структура;
	ПараметрыЗапроса.Вставить("chat_id", СокрЛП(ЧатID));
	ПараметрыЗапроса.Вставить("text",    ТекстСообщения);
	
	// Преобразуем структуру параметров в JSON
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, ПараметрыЗапроса);
	СтрокаJSON = ЗаписьJSON.Закрыть();
	
	// Настройка HTTP-соединения
	Сервер = "api.telegram.org";
	Ресурс = "bot" + СокрЛП(Токен) + "/sendMessage";
	
	ЗащищенноеСоединение = Новый ЗащищенноеСоединениеOpenSSL();
	HTTPСоединение = Новый HTTPСоединение(Сервер, 443, , , , 15, ЗащищенноеСоединение);
	
	HTTPЗапрос = Новый HTTPЗапрос(Ресурс);
	HTTPЗапрос.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	HTTPЗапрос.УстановитьТелоИзСтроки(СтрокаJSON, КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
	
	Попытка
		HTTPОтвет = HTTPСоединение.ОтправитьДляОбъекта(HTTPЗапрос);
		Если HTTPОтвет.КодСостояния = 200 Тогда
			Возврат Истина;
		Иначе
			ЗаписьЖурналаРегистрации("Telegram.Интеграция", УровеньЖурналаРегистрации.Ошибка, , , 
				"Ошибка отправки. Код состояния: " + HTTPОтвет.КодСостояния + ". Ответ сервера: " + HTTPОтвет.ПолучитьТелоКакСтроку());
			Возврат Ложь;
		КонецЕсли;
	Исключение
		ЗаписьЖурналаРегистрации("Telegram.Интеграция", УровеньЖурналаРегистрации.Ошибка, , , 
			"Критическая ошибка при отправке запроса: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Ложь;
	КонецПопытки;
	
КонецФункции

#КонецОбласти


